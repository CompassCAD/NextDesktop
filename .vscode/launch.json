{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Main Process",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/node_modules/electron-vite/bin/electron-vite.js",
      "args": [
        "dev",
        "--inspect=9229"
      ],
      "port": 9229,
      "stopOnEntry": false
    }
  ]
}
