{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Main Process",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/node_modules/electron-vite/bin/electron-vite.js",
      "args": [ "dev", "--", "--inspect=9229", "--remote-debugging-port=9222" ],
      "console": "internalConsole",
      "outputCapture": "std"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Simulate Production Build",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/node_modules/electron-vite/bin/electron-vite.js",
      "args": [ "preview", "--", "--inspect=9229", "--remote-debugging-port=9222" ],
      "console": "internalConsole",
      "outputCapture": "std"
    },
    {
      "type": "pwa-chrome",
      "request": "attach",
      "name": "Attach to Renderer",
      "port": 9222,
      "webRoot": "${workspaceFolder}/src/renderer"
    }
  ],
  "compounds": [
    {
      "name": "Debug Application",
      "configurations": [ "Debug Main Process", "Attach to Renderer" ]
    }
  ]
}
