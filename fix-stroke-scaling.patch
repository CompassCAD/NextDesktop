+import type { DocumentProperties } from './DocumentProperties'
+
+/**
+ * Paper width, in centimetres of paper, of one unit of a component's `radius` (stroke width)
+ * on a paper document. The default stroke width of 2 is therefore 0.25 mm on paper, exactly the
+ * width of the border and title block rules, so default strokes are drawn like the frame.
+ */
+export const PAPER_CM_PER_STROKE_UNIT = 0.0125
+
+/**
+ * World-space multiplier for stroke widths (`radius`) in the current document.
+ *
+ * Infinite canvas: 1. Strokes keep CompassCAD's original behaviour (radius is a width in
+ * drawing units, i.e. 2 px at zoom 1).
+ * Paper canvas: strokes are paper-relative, so they follow the drawing scale like the border
+ * does instead of being 2 cm of real-world geometry (a 5 mm band at 1:4).
+ *
+ * Geometry itself is never rescaled; only how thick it is stroked.
+ */
+export function documentStrokeScale(
+  p: Pick<DocumentProperties, 'canvas' | 'scaleNumerator' | 'scaleDenominator'> | null | undefined
+): number {
+  if (!p || p.canvas !== 'paper') return 1
+  const ratio = p.scaleDenominator / p.scaleNumerator
+  return Number.isFinite(ratio) && ratio > 0 ? PAPER_CM_PER_STROKE_UNIT * ratio : 1
+}
